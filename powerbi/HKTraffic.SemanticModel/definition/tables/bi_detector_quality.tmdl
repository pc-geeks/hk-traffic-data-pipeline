				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"detector_id", type text}, {"corridor", type text}, {"location", type text}, {"district", type text}, {"latitude", type number}, {"longitude", type number}, {"lane_rows", Int64.Type}, {"bad_rows", Int64.Type}, {"bad_share", type number}})
