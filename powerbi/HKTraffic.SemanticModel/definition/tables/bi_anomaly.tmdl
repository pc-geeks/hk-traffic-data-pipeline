	partition bi_anomaly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Text.Combine({#"DataPath", "bi_anomaly.csv"}, "/")), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Cleaned = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Cleaned, {{"obs_date", type date}, {"hour", Int64.Type}, {"detector_id", type text}, {"corridor", type text}, {"location", type text}, {"travel_direction", type text}, {"district", type text}, {"latitude", type number}, {"longitude", type number}, {"wavg_speed", type number}, {"baseline_mean", type number}, {"baseline_std", type number}, {"baseline_days", Int64.Type}, {"drop_share", type number}, {"z_score", type number}, {"is_anomaly", Int64.Type}, {"volume", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

