model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataPath","bi_detector_hour","bi_corridor_hour","bi_hotspot","bi_anomaly","bi_coverage_hour","bi_detector_quality","bi_pipeline_run"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Hour
ref table _Measures
ref table bi_detector_hour
ref table bi_corridor_hour
ref table bi_hotspot
ref table bi_anomaly
ref table bi_coverage_hour
ref table bi_detector_quality
ref table bi_pipeline_run

ref cultureInfo en-US

